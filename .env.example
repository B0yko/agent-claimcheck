# Copy to .env and fill in what you need. Never commit the real file.
# All variables are read from the process environment only; agent-claimcheck
# never parses a .env file itself.

# Base URL of an OpenAI-compatible /chat/completions endpoint.
CLAIMCHECK_BASE_URL=https://openrouter.ai/api/v1

# API key for CLAIMCHECK_BASE_URL. If unset and the base URL host is exactly
# openrouter.ai, OPENROUTER_API_KEY is used instead. That fallback key is
# never sent to any other host.
CLAIMCHECK_API_KEY=

# Model id passed to the judge detector, e.g. deepseek/deepseek-chat.
CLAIMCHECK_MODEL=

# Hard cap in USD for a single live run.
CLAIMCHECK_MAX_USD=

# Path to the cost ledger file. Defaults to ledger.jsonl in the cache
# directory ($XDG_CACHE_HOME/agent-claimcheck or ~/.cache/agent-claimcheck).
CLAIMCHECK_LEDGER=

# Lifetime spend cap in USD across all runs sharing the same ledger.
CLAIMCHECK_LEDGER_CAP_USD=
